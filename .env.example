# ==============================================================================
# AgentShield AI — Environment Configuration
# ==============================================================================

# Deployment Environment ('dev' or 'production')
ENVIRONMENT=dev

# Port for Web Dashboard (Single-Origin Nginx Gateway)
PORT=8080

# PostgreSQL 16 Credentials
POSTGRES_DB=agentshield
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=agentshield_secret_change_me
DATABASE_URL=postgresql://agentshield:agentshield_secret_change_me@db:5432/agentshield

# Security & Secrets (Must generate random values for production)
JWT_SECRET=production_jwt_secret_change_me_in_production_f7a93c4e12b8
API_KEY_PEPPER=production_api_key_pepper_never_share_38c92a11
SECRETS_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtZGV2LWZlcm5ldC1rZXk9PQ==

# Simulator Behavior
# Keep false so the platform monitors only genuine real-world agent traffic.
# Use 'docker compose --profile demo up' to launch autonomous synthetic agents.
SIMULATOR_ENABLED=false
AUTO_SIMULATE=false

# Risk Scoring Thresholds
ALERT_THRESHOLD=60.0
REVIEW_THRESHOLD=70.0
