# ==============================================================================
# AgentShield AI — Environment Configuration Template
# ==============================================================================

# Application Environment: 'dev' or 'production'
# In production, the backend will refuse to boot if default security secrets are unchanged.
ENVIRONMENT=dev

# Database Connection URL
# Dev default uses local async SQLite; Docker Compose overrides with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./agentshield.db
# DATABASE_URL=postgresql+asyncpg://agentshield:agentshield_secret@db:5432/agentshield

# JWT Authentication Configuration
# Generated with: openssl rand -hex 32
JWT_SECRET=dev_jwt_secret_change_me_in_production_f7a93c4e12b8
JWT_ACCESS_MINUTES=30
REFRESH_DAYS=14

# API Key Hashing Pepper
# Used as HMAC-SHA256 key for storing one-way API key hashes.
API_KEY_PEPPER=dev_api_key_pepper_secret_never_share_38c92a11

# Symmetric Secrets Encryption Key (Fernet 32-byte URL-safe base64)
# Used to encrypt sensitive webhook credentials (e.g., PagerDuty routing keys) at rest.
# Generated with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtZGV2LWZlcm5ldC1rZXk9PQ==

# Default Seed Administrator Credentials
ADMIN_EMAIL=admin@agentshield.local
ADMIN_PASSWORD=AdminPassword2026!

# Network & Ingress
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://127.0.0.1:8080","http://127.0.0.1:5173"]
ENABLE_DOCS=true
PUBLIC_BASE_URL=http://localhost:8080

# Security & Detection Thresholds
ALERT_THRESHOLD=60.0
REVIEW_THRESHOLD=70.0
RISK_WEIGHT_RULE=0.4
RISK_WEIGHT_ANOMALY=0.6
ANOMALY_HIGH_THRESHOLD=0.7

# Machine Learning Engine Configuration
ML_FEATURE_SET=v1
ML_MIN_AGENT_SAMPLES=200
ML_MIN_ORG_SAMPLES=500
ML_BOOTSTRAP=true
MODEL_DIR=./models_data

# Realtime & Worker Infrastructure
# EVENT_BUS: 'memory' for single-worker or 'postgres' for LISTEN/NOTIFY multi-worker
EVENT_BUS=memory
WEB_CONCURRENCY=1
RUN_WORKER_INLINE=true

# API Key Rate Limiting
RATE_LIMIT_PER_KEY_PER_MIN=300
KEY_ROTATION_GRACE_HOURS=24

# Data Retention (Days)
RETENTION_DAYS=30
ALERT_RETENTION_DAYS=365

# Observability & Metrics
METRICS_TOKEN=agentshield_metrics_internal_token_99
LOG_LEVEL=INFO

# Demo Mode & Synthetic Simulation
DEMO_MODE=false
SIMULATOR_ENABLED=false

# Frontend API Configuration
VITE_API_BASE=/api
